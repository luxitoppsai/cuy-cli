{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "_comentario": "Paleta cálida de tierra, legible en sesiones largas. Los colores de identidad (ámbar, terracota) se reservan para lo que el usuario debe mirar; el resto queda en grises neutros para no competir con el código.",

    "ambar": "#e0a34a",
    "ambarClaro": "#8a5a10",
    "terracota": "#d4735e",
    "terracotaClaro": "#a8412a",
    "arcilla": "#c9906b",
    "arcillaClara": "#8a5333",

    "verde": "#7fae6a",
    "verdeClaro": "#3f6b2e",
    "rojo": "#d9615c",
    "rojoClaro": "#a52b26",
    "amarillo": "#dfb757",
    "amarilloClaro": "#8a6510",
    "cian": "#6fa8a0",
    "cianClaro": "#2d6159",
    "violeta": "#a48ac4",
    "violetaClaro": "#5e4485",

    "fondo": "#14120f",
    "fondoPanel": "#1c1916",
    "fondoElemento": "#252019",
    "texto": "#ece6dc",
    "textoTenue": "#948b7d",
    "borde": "#312a22",
    "bordeActivo": "#4a3f33",
    "bordeSutil": "#25201a",

    "fondoL": "#faf7f2",
    "fondoPanelL": "#f2ede4",
    "fondoElementoL": "#e8e0d4",
    "textoL": "#2a241d",
    "textoTenueL": "#6b6357",
    "bordeL": "#ded5c7",
    "bordeActivoL": "#c4b7a4",
    "bordeSutilL": "#ebe4d9"
  },
  "theme": {
    "primary": { "dark": "ambar", "light": "ambarClaro" },
    "secondary": { "dark": "arcilla", "light": "arcillaClara" },
    "accent": { "dark": "terracota", "light": "terracotaClaro" },
    "error": { "dark": "rojo", "light": "rojoClaro" },
    "warning": { "dark": "amarillo", "light": "amarilloClaro" },
    "success": { "dark": "verde", "light": "verdeClaro" },
    "info": { "dark": "cian", "light": "cianClaro" },

    "text": { "dark": "texto", "light": "textoL" },
    "textMuted": { "dark": "textoTenue", "light": "textoTenueL" },
    "background": { "dark": "fondo", "light": "fondoL" },
    "backgroundPanel": { "dark": "fondoPanel", "light": "fondoPanelL" },
    "backgroundElement": { "dark": "fondoElemento", "light": "fondoElementoL" },
    "border": { "dark": "borde", "light": "bordeL" },
    "borderActive": { "dark": "bordeActivo", "light": "bordeActivoL" },
    "borderSubtle": { "dark": "bordeSutil", "light": "bordeSutilL" },

    "diffAdded": { "dark": "verde", "light": "verdeClaro" },
    "diffRemoved": { "dark": "rojo", "light": "rojoClaro" },
    "diffContext": { "dark": "textoTenue", "light": "textoTenueL" },
    "diffHunkHeader": { "dark": "arcilla", "light": "arcillaClara" },
    "diffHighlightAdded": { "dark": "verde", "light": "verdeClaro" },
    "diffHighlightRemoved": { "dark": "rojo", "light": "rojoClaro" },
    "diffAddedBg": { "dark": "#1b2617", "light": "#dcecd4" },
    "diffRemovedBg": { "dark": "#2b1a18", "light": "#f4dcd9" },
    "diffContextBg": { "dark": "fondoPanel", "light": "fondoPanelL" },
    "diffLineNumber": { "dark": "textoTenue", "light": "textoTenueL" },
    "diffAddedLineNumberBg": { "dark": "#16200f", "light": "#cfe3c5" },
    "diffRemovedLineNumberBg": { "dark": "#241413", "light": "#edcdc9" },

    "markdownText": { "dark": "texto", "light": "textoL" },
    "markdownHeading": { "dark": "ambar", "light": "ambarClaro" },
    "markdownLink": { "dark": "cian", "light": "cianClaro" },
    "markdownLinkText": { "dark": "terracota", "light": "terracotaClaro" },
    "markdownCode": { "dark": "verde", "light": "verdeClaro" },
    "markdownBlockQuote": { "dark": "textoTenue", "light": "textoTenueL" },
    "markdownEmph": { "dark": "amarillo", "light": "amarilloClaro" },
    "markdownStrong": { "dark": "ambar", "light": "ambarClaro" },
    "markdownHorizontalRule": { "dark": "borde", "light": "bordeL" },
    "markdownListItem": { "dark": "terracota", "light": "terracotaClaro" },
    "markdownListEnumeration": { "dark": "cian", "light": "cianClaro" },
    "markdownImage": { "dark": "cian", "light": "cianClaro" },
    "markdownImageText": { "dark": "terracota", "light": "terracotaClaro" },
    "markdownCodeBlock": { "dark": "texto", "light": "textoL" },

    "syntaxComment": { "dark": "textoTenue", "light": "textoTenueL" },
    "syntaxKeyword": { "dark": "violeta", "light": "violetaClaro" },
    "syntaxFunction": { "dark": "ambar", "light": "ambarClaro" },
    "syntaxVariable": { "dark": "terracota", "light": "terracotaClaro" },
    "syntaxString": { "dark": "verde", "light": "verdeClaro" },
    "syntaxNumber": { "dark": "arcilla", "light": "arcillaClara" },
    "syntaxType": { "dark": "amarillo", "light": "amarilloClaro" },
    "syntaxOperator": { "dark": "cian", "light": "cianClaro" },
    "syntaxPunctuation": { "dark": "texto", "light": "textoL" }
  }
}
