#!/usr/bin/env bash
# Lanza OpenCode en modo blindado: sin salidas de red fuera del proveedor configurado.
#
# Verificado observando las conexiones reales del proceso (ver spike/RED.md): sin estas
# variables contacta api.opencode.ai durante una sesión normal, aun con un proveedor
# propio; con ellas, el único destino es Databricks.
#
# Uso:  ./cuy [argumentos de opencode]
#       ./cuy run "arreglá el test que falla"

set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Credenciales y host del entorno.
if [[ -f "$RAIZ/.env" ]]; then
  set -a; source "$RAIZ/.env"; set +a
fi

# --- Blindaje de red -----------------------------------------------------------------
# No buscar actualizaciones: evita la llamada a api.opencode.ai y, de paso, que la
# versión cambie sola bajo los pies del equipo.
export OPENCODE_DISABLE_AUTOUPDATE=1
# No descargar el catálogo de modelos: el nuestro lo genera `generar_config.py` desde el
# propio workspace, así que el catálogo remoto no aporta nada y sí abre una conexión.
export OPENCODE_DISABLE_MODELS_FETCH=1
# No compartir sesiones. Compartir una sesión sube la conversación —con el código
# adentro— a un servidor de terceros: es la fuga más grave posible acá.
export OPENCODE_DISABLE_SHARE=1
export OPENCODE_AUTO_SHARE=0
# No descargar servidores de lenguaje ni skills externas en tiempo de ejecución.
export OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1

# --- Presupuesto y auditoría ----------------------------------------------------------
export CUY_LIMITE_TOKENS="${CUY_LIMITE_TOKENS:-300000}"

BINARIO="$RAIZ/node_modules/.bin/opencode"
if [[ ! -x "$BINARIO" ]]; then
  echo "OpenCode no está instalado. Corré:  python3 instalar.py"
  exit 1
fi

exec "$BINARIO" "$@"
