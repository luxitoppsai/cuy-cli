# Nunca versionar credenciales
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.token
.databrickscfg

__pycache__/
*.pyc
.DS_Store
node_modules/
spike/tarea/opencode.json

# Configuración específica del entorno: la genera instalar.py (D7 del RFC)
opencode.json
.opencode/

# Estado del sistema de memoria: se reescribe solo, no va al repo
.memory/

# Artefactos de compilación del agente: se generan, no se versionan
vendor/opencode/node_modules/
vendor/opencode/packages/*/dist/
vendor/opencode/packages/*/node_modules/
certificados-sistema.pem
bin/

# Binarios preparados para releases
dist-release/

# Revisión cruzada entre agentes: conversación de trabajo, no documentación
REVISION.md

# Entornos Python y cachés locales
.venv/
venv/
.pytest_cache/

# Demo HTML generada localmente; docs/demo.html permanece versionado
/cuy-demo.html

# Índice local de Cuy (generado)
/.cuy/codegraph/
/.codegraph-state/
